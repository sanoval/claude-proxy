#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const { execSync, spawn } = require('child_process');
const os = require('os');

const SETTINGS_FILE = path.join(os.homedir(), '.claude', 'settings.json');
const CONFIG_FILE = process.env.CLAUDE_PROXY_CONFIG || path.join(os.homedir(), '.config', 'claude-proxy', 'config.json');
const PLACEHOLDER_TOKEN = 'replace-with-your-token';
const PORT = 20128;

// Proxy env comes from the JSON config (see config.example.json).
// CLAUDE_PROXY_AUTH_TOKEN, when set, overrides ANTHROPIC_AUTH_TOKEN from that file.
function loadProxyEnv() {
  let config;
  try {
    config = JSON.parse(fs.readFileSync(CONFIG_FILE, 'utf8'));
  } catch (err) {
    throw new Error(`cannot read ${CONFIG_FILE} (${err.message}). Copy config.example.json there and fill it in.`);
  }

  if (!config || typeof config !== 'object' || Array.isArray(config)) {
    throw new Error(`${CONFIG_FILE} must contain a JSON object`);
  }
  for (const [key, value] of Object.entries(config)) {
    if (typeof value !== 'string') {
      throw new Error(`${CONFIG_FILE}: "${key}" must be a string`);
    }
  }

  const env = { ...config };
  if (process.env.CLAUDE_PROXY_AUTH_TOKEN) {
    env.ANTHROPIC_AUTH_TOKEN = process.env.CLAUDE_PROXY_AUTH_TOKEN;
  }
  if (!env.ANTHROPIC_AUTH_TOKEN || env.ANTHROPIC_AUTH_TOKEN === PLACEHOLDER_TOKEN) {
    throw new Error('no auth token: set ANTHROPIC_AUTH_TOKEN in the config or export CLAUDE_PROXY_AUTH_TOKEN');
  }
  return env;
}

function readSettings() {
  try {
    return JSON.parse(fs.readFileSync(SETTINGS_FILE, 'utf8'));
  } catch (err) {
    return {};
  }
}

function writeSettings(data) {
  fs.writeFileSync(SETTINGS_FILE, JSON.stringify(data, null, 2) + '\n', 'utf8');
}

function is9RouterRunning() {
  try {
    const out = execSync('pgrep -f "9router" 2>/dev/null', { encoding: 'utf8' }).trim();
    return out.length > 0;
  } catch {
    return false;
  }
}

function kill9Router() {
  try {
    // Kill by port
    const pidsPort = execSync(`lsof -ti:${PORT} 2>/dev/null`, { encoding: 'utf8' }).trim().split(/\s+/).filter(Boolean);
    for (const pid of pidsPort) {
      try { process.kill(Number(pid), 'SIGKILL'); } catch {}
    }
  } catch {}

  try {
    // Kill processes matching 9router
    const out = execSync('ps aux 2>/dev/null', { encoding: 'utf8' });
    const lines = out.split('\n');
    for (const line of lines) {
      const lower = line.toLowerCase();
      if ((lower.includes('node') && lower.includes('9router')) || lower.includes('/bin/9router')) {
        const parts = line.trim().split(/\s+/);
        const pid = parts[1];
        if (pid && pid !== String(process.pid)) {
          try { process.kill(Number(pid), 'SIGKILL'); } catch {}
        }
      }
    }
  } catch {}
}

function start9Router() {
  const child = spawn('9router', ['--no-browser', '--tray'], {
    detached: true,
    stdio: 'ignore',
    env: process.env
  });
  child.unref();
}

const cmd = process.argv[2];

if (cmd === 'on') {
  let proxyEnv;
  try {
    proxyEnv = loadProxyEnv();
  } catch (err) {
    console.error(`[claude-proxy] ${err.message}`);
    process.exit(1);
  }

  if (!is9RouterRunning()) {
    start9Router();
    console.log('[claude-proxy] 9router started in background.');
  } else {
    console.log('[claude-proxy] 9router already running.');
  }

  const settings = readSettings();
  settings.hasCompletedOnboarding = true;
  settings.env = settings.env || {};
  Object.assign(settings.env, proxyEnv);

  writeSettings(settings);
  console.log('[claude-proxy] Status: ON. Settings updated with 9router proxy config.');
} else if (cmd === 'off') {
  kill9Router();
  console.log('[claude-proxy] 9router stopped.');

  let proxyKeys;
  try {
    proxyKeys = Object.keys(loadProxyEnv());
  } catch (err) {
    console.error(`[claude-proxy] ${err.message}`);
    console.error('[claude-proxy] settings.json left unchanged; remove the proxy env keys manually.');
    process.exit(1);
  }

  const settings = readSettings();
  if (settings.env) {
    for (const key of proxyKeys) {
      delete settings.env[key];
    }
    if (Object.keys(settings.env).length === 0) {
      delete settings.env;
    }
  }

  writeSettings(settings);
  console.log('[claude-proxy] Status: OFF. Proxy env removed from settings.json.');
} else if (cmd === 'status') {
  const running = is9RouterRunning();
  const settings = readSettings();
  const hasProxy = Boolean(settings.env && settings.env.ANTHROPIC_BASE_URL);
  console.log(`[claude-proxy] Process 9router: ${running ? 'RUNNING' : 'STOPPED'}`);
  console.log(`[claude-proxy] Proxy config in settings.json: ${hasProxy ? 'ENABLED' : 'DISABLED'}`);
} else {
  console.log('Usage: claude-proxy <on|off|status>');
  process.exit(1);
}
